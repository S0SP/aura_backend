# ==========================================
# AURA Fact-Checker - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# === App Settings ===
APP_NAME=AURA Fact-Checker
VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# === CORS (JSON array format) ===
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]

# === Security ===
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === MongoDB (Docker) ===
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=aura_factchecker

# === Redis (Docker) ===
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# === Neo4j (Docker) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_min_8_chars

# === Pinecone (Free Tier) ===
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=aura-facts

# === Embeddings (Local - No API Key Needed) ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_DIMENSION=384

# === Chunking Settings (Optimized for RAG) ===
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_STRATEGY=recursive

# === Google Gemini (Free Tier - Primary LLM) ===
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-1.5-flash

# === Groq (Free Tier - Backup LLM) ===
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile

# === SerpAPI (Free Trial - 100 searches/month) ===
# Get from: https://serpapi.com/
SERP_API_KEY=your_serp_api_key

# === Firecrawl (Free Tier) ===
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key

# === HuggingFace (Your XLM-RoBERTa Model) ===
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key
XLM_ROBERTA_ENDPOINT=https://api-inference.huggingface.co/models/your-username/your-model

# === ElevenLabs (Free Tier - 10,000 chars/month) ===
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Facebook/WhatsApp Business API ===
# Get from: https://developers.facebook.com/
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_ACCESS_TOKEN=your_facebook_access_token
FB_PHONE_NUMBER_ID=your_phone_number_id
FB_BUSINESS_ACCOUNT_ID=your_business_account_id
FB_WEBHOOK_VERIFY_TOKEN=aura_webhook_verify_token_change_this
FB_API_VERSION=v18.0

# === Celery (uses Redis) ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Debate Engine ===
MAX_DEBATE_ROUNDS=4
EXCHANGES_PER_ROUND=4
DEBATE_TIMEOUT_SECONDS=300

# === WebSocket ===
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=text
